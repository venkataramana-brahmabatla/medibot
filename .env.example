# ==========================================
# MediBot Environment Configuration
# ==========================================

# Application Settings
APP_ENV=development
APP_NAME=MediBot
DEBUG=false
DEMO_AUTH_ENABLED=false
# Set a private local-only value (16+ characters) only if demo auth is enabled.
DEMO_AUTH_PASSWORD=

# Authentication & Security (JWT Secret)
# Generate a private value with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_EXPIRY_HOURS=1

# Groq LLM API
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
ALLOW_EXTERNAL_LLM_DATA=false

# Model Selection
GROQ_MODEL=qwen/qwen3.8-27b

# Vector Store (Qdrant Local or Cloud)
QDRANT_PATH=./data/qdrant_db
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Embedding & Reranker Models
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage & Paths
DATA_DIR=./data
DB_PATH=./data/documents/db/mediassist.db

# Evaluation thresholds
EVALUATION_LATENCY_LIMIT_SECONDS=30
EVALUATION_RAGAS_THRESHOLD=0.70
EVALUATION_JUDGE_THRESHOLD=4.0
LANGSMITH_TRACING=false
LANGSMITH_TRACE_CONTENT=false
