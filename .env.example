# ==========================================
# MediBot Environment Configuration
# ==========================================

# Application Settings
APP_ENV=development
APP_NAME=MediBot
DEBUG=True

# Authentication & Security (JWT Secret)
JWT_SECRET_KEY=medibot_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# LLM Provider
# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
DEFAULT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b

# Vector Store (Qdrant Local or Cloud)
QDRANT_PATH=./data/qdrant_db
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Embedding & Reranker Models
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage & Paths
DATA_DIR=./data
DB_PATH=./data/documents/db/mediassist.db
